{
  "name": "verme-gate",
  "version": "0.3.25",
  "private": true,
  "type": "module",
  "description": "verme-gate (ex dsh-mcp-access) — DSH plugin: LiteLLM token = access profile for MCP servers/tools/models, native settings screen",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": "^0.2.1-rc.2 || ^0.2.2-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.1-rc.2 || ^0.2.2-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": []
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "sync:prompts": "node scripts/sync-prompts.mjs",
    "check:prompts": "node scripts/sync-prompts.mjs --check",
    "selftest": "node selftest.mjs",
    "release": "node scripts/release.mjs"
  },
  "files": [
    "index.js",
    "lib",
    "client",
    "scripts",
    "prompts",
    "page.html",
    "README.md",
    "selftest.mjs",
    "cordis.patch.yml"
  ]
}
